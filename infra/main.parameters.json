{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "dev"
    },
    "appName": {
      "value": "azure-memforest"
    },
    "containerImage": {
      "value": "REPLACE_ME_BEFORE_DEPLOY"
    },
    "containerPort": {
      "value": 8000
    },
    "minReplicas": {
      "value": 0
    },
    "maxReplicas": {
      "value": 1
    },
    "cosmosPublicNetworkAccess": {
      "value": "Enabled"
    },
    "searchPublicNetworkAccess": {
      "value": "enabled"
    },
    "searchRecallIndexName": {
      "value": "memforest-recall"
    },
    "tags": {
      "value": {
        "workload": "azure-memforest",
        "environment": "dev"
      }
    }
  }
}
